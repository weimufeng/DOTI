# 百度统计站点 ID（tongji.baidu.com → 代码获取里 hm.js? 后面那段）
VITE_BAIDU_TONGJI_ID=

# 可选：Google Analytics 4 Measurement ID（G-XXXXXXXX）
VITE_GA_MEASUREMENT_ID=

# 首页浏览量/地域：OpenAPI 密钥（不要加 VITE_ 前缀，否则会打进前端包）
# 文档：https://tongji.baidu.com/api/manual/Chapter2/openapi.html
# BAIDU_TONGJI_API_KEY=
# BAIDU_TONGJI_SECRET_KEY=
# BAIDU_TONGJI_REFRESH_TOKEN=
# 或直接填未过期的 access_token：
# BAIDU_TONGJI_ACCESS_TOKEN=
# 可选，数字站点 ID（不是 hm.js 那串）；不填则按 github.io 域名自动选
# BAIDU_TONGJI_SITE_ID=
